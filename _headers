# NOTE: This file is not used by Netlify (headers are configured in netlify.toml).
# For reference only. The functional headers file is in public/_headers (copied to out/_headers at build time).

    Cache-Control = "public, max-age=31536000"

# Redirect rules
[[redirects]]
  from = "/index.html"
  to = "/"
  status = 301

# SPA fallback for client-side routing (if needed)
[[redirects]]
  from = "/*"
  to = "/index.html"
  status = 200
